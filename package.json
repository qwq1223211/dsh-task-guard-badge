{
  "name": "dsh-task-guard-badge",
  "version": "0.7.2",
  "type": "module",
  "description": "Shows the live task-guard state as a compact pill that expands into a detail panel: kept/removed tool names, narrowing ratio, per-turn savings and payback.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/owners.js",
    "lib/state.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.4"
  },
  "keywords": [
    "dsh-plugin",
    "ui",
    "task-guard",
    "deepseek-harness",
    "badge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwq1223211/dsh-task-guard-badge.git"
  },
  "homepage": "https://github.com/qwq1223211/dsh-task-guard-badge#readme",
  "bugs": {
    "url": "https://github.com/qwq1223211/dsh-task-guard-badge/issues"
  },
  "author": "qwq1223211 (https://github.com/qwq1223211)"
}
